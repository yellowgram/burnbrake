# BurnBrake self-host example.
# `burnbrake serve` does not load this file or a copied .env. Export the variables.
# Docker Compose reads THIS file (env_file: config.example.env). A copied .env is ignored.
# The keys below are public placeholders. Compose publishes 127.0.0.1 only. Replace them before anyone else can reach the port.
# Never put the provider API key in BURNBRAKE_KEY.

BURNBRAKE_HOST=127.0.0.1
BURNBRAKE_PORT=8787
BURNBRAKE_KEY=bb_replace_me
# Operator HTTP only. Must differ from BURNBRAKE_KEY and from the provider key.
# Leave unset to disable /v1/operator/* (the CLI on the sqlite file still works).
BURNBRAKE_OPERATOR_KEY=bb_operator_replace_me
# Public bind is opt-in and still requires the key above. Do not publish 0.0.0.0 without an ACL.
# BURNBRAKE_ALLOW_PUBLIC_BIND=1

BURNBRAKE_LEDGER_PATH=data/burnbrake.sqlite
BURNBRAKE_PRICE_TABLE=prices/openai.yaml
# Offline proof. Unset this and set OPENAI_API_KEY to forward to a real provider.
BURNBRAKE_MOCK_UPSTREAM=1
# BURNBRAKE_UPSTREAM_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=sk-replace-me-not-the-burnbrake-key

# Caps. Production (NODE_ENV=production or BURNBRAKE_PRODUCTION=1) requires user and/or day.
# Per-run alone is washable by minting run ids and is refused in production.
BURNBRAKE_CAP_USER_USD=10
BURNBRAKE_CAP_RUN_USD=1
BURNBRAKE_CAP_DAY_USD=5

# LaunchGate defaults. Change only if you mean to.
# BURNBRAKE_DEFAULT_MAX_TOKENS=4096
# BURNBRAKE_RESERVATION_TTL_MS=900000

# Brake curve. Default off. Not a halt-off switch. At the cap the response is still 402.
# BURNBRAKE_BRAKE_ENABLED=false
# BURNBRAKE_BRAKE_AMBER_PCT=30
# BURNBRAKE_BRAKE_RED_PCT=10
# BURNBRAKE_BRAKE_AMBER_DELAY_MS=0
# BURNBRAKE_BRAKE_RED_DELAY_MS=0
# BURNBRAKE_BRAKE_BLACK_DELAY_MS=0
# BURNBRAKE_BRAKE_MAX_DELAY_MS=15000
