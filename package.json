{
  "name": "burnbrake",
  "version": "0.3.0",
  "description": "A small proxy that puts hard dollar caps on agent LLM calls (OpenAI and Anthropic, streaming included).",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "yellowgram",
    "url": "https://www.yellowgram.dev"
  },
  "homepage": "https://www.yellowgram.dev/oss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowgram/burnbrake.git"
  },
  "bugs": {
    "url": "https://github.com/yellowgram/burnbrake/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "burnbrake": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "files": [
    "dist",
    "prices",
    "docs",
    "README.md",
    "config.example.env",
    "Dockerfile",
    "docker-compose.yml",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/cli.js serve",
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts serve",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts test/review/*.test.ts",
    "demo": "node --disable-warning=ExperimentalWarning --import tsx scripts/demo-60s.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
